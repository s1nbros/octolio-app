# Copy to .env and set for device testing / production builds.
# Expo exposes EXPO_PUBLIC_* vars to the app at build time.

# The backend base URL the app talks to (backend owns the Neon database).
#  - iOS simulator + local backend:   http://localhost:3001   (this is the dev default)
#  - Android emulator + local backend: http://10.0.2.2:3001   (this is the dev default)
#  - Physical device + local backend:  http://<your-LAN-IP>:3001   (REQUIRED — localhost is the phone)
#  - Production:                        https://your-deployed-backend
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
