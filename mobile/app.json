{
  "expo": {
    "name": "Octolio",
    "slug": "octolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "octolio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "me.octolio.app",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "me.octolio.app",
      "adaptiveIcon": { "backgroundColor": "#0e1018" }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": { "origin": false }
    }
  }
}
